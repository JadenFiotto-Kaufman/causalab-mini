{
  "header": {
    "description": "DAS on a real model: a k-dimensional subspace of the day token's residual stream that, swapped alone, carries 'today' from the counterfactual. Fit on 30 pairs, scored on 12 held-out pairs; k is swept, so the document is the rank curve."
  },
  "model": {
    "key": "meta-llama/Llama-3.2-1B",
    "revision": "4e20de362430cd3b72f300e6b0f18e50e7166e08",
    "dtype": "fp32"
  },
  "data": {
    "train": {"path": "weekdays_full/data#train"},
    "test": {"path": "weekdays_full/data#test"}
  },
  "sites": {
    "target": {"component": "block_output", "layers": 8},
    "head": {"component": "lm_head"}
  },
  "featurizers": {"rot": {"kind": "subspace", "k": {"sweep": [1, 4, 16, 64]}}},
  "interventions": {
    "cf_read": {"reads": {"v_cf": {"site": "target", "pos": -4, "featurizer": "fit.rot"}}},
    "das": {
      "writes": {
        "patch": {
          "site": "target",
          "pos": -4,
          "mechanism": "swap",
          "operand": "counterfactual.v_cf",
          "featurizer": "fit.rot"
        }
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    }
  },
  "steps": {
    "fit": {
      "kind": "fit",
      "train": ["rot"],
      "objective": [[1.0, "ce"]],
      "epochs": 20,
      "batch_size": 10,
      "seed": 0,
      "optimizer": {"name": "adamw", "lr": 0.003, "weight_decay": 0.0},
      "early_stop": {"metric": "iia", "mode": "max", "patience": 20},
      "eval": {"data": {"train": "test"}},
      "steps": {
        "counterfactual": {
          "kind": "forward",
          "data": "train",
          "field": "counterfactual_inputs[0]",
          "interventions": "cf_read"
        },
        "patched": {"kind": "forward", "data": "train", "field": "input", "interventions": "das"},
        "iia": {
          "kind": "metric",
          "metric": "match",
          "of": "patched.logits",
          "expected": "train.cf_answer"
        },
        "logit_diff": {
          "kind": "metric",
          "metric": "logit_diff",
          "of": "patched.logits",
          "a": "train.cf_answer",
          "b": "train.base_answer"
        },
        "ce": {
          "kind": "metric",
          "metric": "cross_entropy",
          "of": "patched.logits",
          "target": "train.cf_answer"
        }
      }
    },
    "counterfactual": {
      "kind": "forward",
      "data": "test",
      "field": "counterfactual_inputs[0]",
      "interventions": "cf_read"
    },
    "patched": {"kind": "forward", "data": "test", "field": "input", "interventions": "das"},
    "iia": {
      "kind": "metric",
      "metric": "match",
      "of": "patched.logits",
      "expected": "test.cf_answer"
    },
    "logit_diff": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "patched.logits",
      "a": "test.cf_answer",
      "b": "test.base_answer"
    },
    "ce": {
      "kind": "metric",
      "metric": "cross_entropy",
      "of": "patched.logits",
      "target": "test.cf_answer"
    },
    "saves": {
      "fit.iia": "held_out_iia.json",
      "iia": "iia.json",
      "logit_diff": "logit_diff.json",
      "fit.rot": "rot.safetensors"
    }
  }
}

{
  "header": {
    "description": "Where is 'today' held? Interchange the residual stream between a base and a counterfactual day at the day token itself (-4 of 'If today is X , tomorrow is'), at every one of the 16 layers. Its sibling document does the other position; together they show the information crossing from the day token to the last."
  },
  "model": {
    "key": "meta-llama/Llama-3.2-1B",
    "revision": "4e20de362430cd3b72f300e6b0f18e50e7166e08",
    "dtype": "fp32"
  },
  "roles": {
    "base": {
      "field": "input"
    },
    "counterfactual": {
      "field": "counterfactual_inputs[0]"
    }
  },
  "sites": {
    "target": {
      "component": "block_output",
      "layers": {
        "sweep": [
          [
            0
          ],
          [
            1

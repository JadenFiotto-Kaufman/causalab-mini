{
  "header": {
    "description": "Does the model do the task at all? No intervention: the un-patched model's answer to 'If today is X, tomorrow is', scored against the right day. Everything else in this directory means nothing unless this is near 1."
  },
  "model": {
    "key": "meta-llama/Llama-3.2-1B",
    "revision": "4e20de362430cd3b72f300e6b0f18e50e7166e08",
    "dtype": "fp32"
  },
  "roles": {
    "base": {
      "field": "input"
    }
  },
  "sites": {
    "head": {
      "component": "lm_head"
    }
  },
  "interventions": {
    "behavior": {
      "reads": {
        "logits": {
          "site": "head",
          "pos": -1,
          "model": "original",
          "input": "base"
        }
      },
      "writes": {},
      "models": {},
      "metrics": {
        "accuracy": {
          "kind": "match",
          "of": "logits",
          "token_form": "space_prefixed",
          "expected": "base_answer"
        },
        "p_answer": {
          "kind": "token_prob",
          "of": "logits",
          "token_form": "space_prefixed",
          "token": "base_answer"
        }
      }
    }
  },
  "steps": {
    "score": {
      "kind": "observe",
      "intervention": "behavior",
      "rows": {
        "base": "weekdays_full/data"
      },
      "saves": [
        {
          "value": "accuracy",
          "file_path": "accuracy.json"
        },
        {
          "value": "p_answer",
          "file_path": "p_answer.json"
        }
      ]
    }
  }
}

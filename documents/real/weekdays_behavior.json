{
  "header": {
    "description": "Does the model do the task at all? No intervention: the un-patched model's answer to 'If today is X, tomorrow is', scored against the right day. Everything else in this directory means nothing unless this is near 1."
  },
  "model": {
    "key": "meta-llama/Llama-3.2-1B",
    "revision": "4e20de362430cd3b72f300e6b0f18e50e7166e08",
    "dtype": "fp32"
  },
  "data": {"days": {"path": "weekdays_full/data"}},
  "sites": {"head": {"component": "lm_head"}},
  "steps": {
    "answer": {
      "kind": "forward",
      "data": "days",
      "field": "input",
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "accuracy": {
      "kind": "metric",
      "metric": "match",
      "of": "answer.logits",
      "expected": "days.base_answer"
    },
    "p_answer": {
      "kind": "metric",
      "metric": "token_prob",
      "of": "answer.logits",
      "token": "days.base_answer"
    },
    "saves": {"accuracy": "accuracy.json", "p_answer": "p_answer.json"}
  }
}

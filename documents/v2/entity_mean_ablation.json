{
  "header": {
    "description": "Mean ablation where the mean is taken over a RAGGED read: the tokens of each row's entity (`{'all': true, 'scope': {'variable': 'entity'}}` — the row's own entity text, located in its prompt — one token for Friday, three for Thursday), averaged over every entity token in the corpus, then swapped in at the answer position. A mean over a ragged read is one vector, so it lands at any window. A row whose entity text is not in its prompt would contribute nothing and stay a row; here every row has one."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"prompts": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "block_output", "layers": 0},
    "head": {"component": "lm_head"}
  },
  "steps": {
    "harvest": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"acts": {"site": "target", "pos": {"all": true, "scope": {"variable": "entity"}}}}
    },
    "mean": {"kind": "reduce", "reduce": "mean", "of": "harvest.acts"},
    "clean": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "clean_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "clean.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "ablated": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "interventions": {
        "writes": {"ablate": {"site": "target", "pos": -1, "mechanism": "swap", "operand": "mean"}}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "ablated_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "ablated.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "saves": {
      "mean": "entity_mean.safetensors",
      "clean_ld": "clean.json",
      "ablated_ld": "ablated.json"
    }
  }
}

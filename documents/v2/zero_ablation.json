{
  "header": {
    "description": "Zero ablation, the cheapest baseline there is: the residual stream at the answer position replaced by 0.0, scored against the un-intervened model. The operand is a number, not a reference to anything read."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"prompts": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "block_output", "layers": 0},
    "head": {"component": "lm_head"}
  },
  "steps": {
    "clean": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "clean_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "clean.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "zeroed": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "interventions": {
        "writes": {"zero": {"site": "target", "pos": -1, "mechanism": "swap", "operand": 0.0}}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "zeroed_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "zeroed.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "p_answer": {
      "kind": "metric",
      "metric": "token_prob",
      "of": "zeroed.logits",
      "token": "prompts.cf_answer"
    },
    "saves": {"clean_ld": "clean.json", "zeroed_ld": "zeroed.json", "p_answer": "p_answer.json"}
  }
}

{
  "header": {
    "description": "Two experiments at one site, each named once and bound by its own step, and a baseline written in place. `interventions` declares interchange patching and mean ablation at the last position of layer 0; nothing there runs. `clean` is an intervention with no writes, written inline on its step: it reads the original model, scores it, and publishes the mean activation at the site. `patched` and `ablated` each name the declared experiment they run, and `ablated` swaps in the mean `clean` published. Tiny CPU Llama, so the numbers demonstrate the mechanism and nothing else."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "roles": {
    "base": {
      "field": "input"
    },
    "counterfactual": {
      "field": "counterfactual_inputs[0]"
    }
  },
  "sites": {
    "target": {
      "component": "block_output",
      "layers": [
        0
      ]
    },
    "head": {
      "component": "lm_head"
    }
  },
  "interventions": {
    "patching": {
      "reads": {
        "v_cf": {
          "site": "target",
          "pos": -1,
          "model": "original",
          "input": "counterfactual"
        },
        "logits": {
          "site": "head",
          "pos": -1,
          "model": "patched",
          "input": "base"
        }
      },
      "writes": {
        "patch": {
          "site": "target",
          "pos": -1,
          "mechanism": "swap",
          "operand": "v_cf"
        }
      },
      "models": {
        "patched": {
          "input": "base",
          "writes": [
            "patch"
          ]
        }
      },
      "metrics": {
        "iia": {
          "kind": "match",
          "of": "logits",
          "expected": "cf_answer",
          "token_form": "space_prefixed"
        },
        "logit_diff": {
          "kind": "logit_diff",
          "of": "logits",
          "a": "cf_answer",
          "b": "base_answer",
          "token_form": "space_prefixed"
        }
      }
    },
    "mean_ablation": {
      "reads": {
        "logits": {
          "site": "head",
          "pos": -1,
          "model": "ablated",
          "input": "base"
        }
      },
      "writes": {
        "ablate": {
          "site": "target",
          "pos": -1,
          "mechanism": "swap",
          "operand": {
            "ref": "mean"
          }
        }
      },
      "models": {
        "ablated": {
          "input": "base",
          "writes": [
            "ablate"
          ]
        }
      },
      "metrics": {
        "logit_diff": {
          "kind": "logit_diff",
          "of": "logits",
          "a": "cf_answer",
          "b": "base_answer",
          "token_form": "space_prefixed"
        }
      }
    }
  },
  "steps": {
    "clean": {
      "kind": "observe",
      "intervention": {
        "reads": {
          "acts": {
            "site": "target",
            "pos": -1,
            "model": "original",
            "input": "base"
          },
          "logits": {
            "site": "head",
            "pos": -1,
            "model": "original",
            "input": "base"
          }
        },
        "metrics": {
          "logit_diff": {
            "kind": "logit_diff",
            "of": "logits",
            "a": "cf_answer",
            "b": "base_answer",
            "token_form": "space_prefixed"
          }
        }
      },
      "rows": {
        "base": "weekdays/train",
        "counterfactual": "weekdays/train"
      },
      "outputs": {
        "mean": {
          "read": "acts",
          "reduce": "mean"
        }
      },
      "saves": [
        {
          "value": "logit_diff",
          "file_path": "clean.json"
        }
      ]
    },
    "patched": {
      "kind": "observe",
      "intervention": "patching",
      "rows": {
        "base": "weekdays/train",
        "counterfactual": "weekdays/train"
      },
      "saves": [
        {
          "value": "logit_diff",
          "file_path": "patched.json"
        }
      ]
    },
    "ablated": {
      "kind": "observe",
      "intervention": "mean_ablation",
      "rows": {
        "base": "weekdays/train",
        "counterfactual": "weekdays/train"
      },
      "saves": [
        {
          "value": "logit_diff",
          "file_path": "ablated.json"
        }
      ]
    }
  }
}

{
  "header": {
    "description": "Mean ablation. `harvest` reads the residual stream at the answer position over the corpus and `mean` averages it over the rows; `clean` scores the un-intervened model; `ablated` swaps the mean in at that position and scores again. The mean is one step's value and a later step's operand; it reaches disk only because a save names it. Tiny CPU Llama, so the numbers demonstrate the mechanism and nothing else."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"prompts": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "block_output", "layers": 0},
    "head": {"component": "lm_head"}
  },
  "steps": {
    "harvest": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"acts": {"site": "target", "pos": -1}}
    },
    "mean": {"kind": "reduce", "reduce": "mean", "of": "harvest.acts"},
    "clean": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "clean_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "clean.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "ablated": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "interventions": {
        "writes": {"ablate": {"site": "target", "pos": -1, "mechanism": "swap", "operand": "mean"}}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "ablated_ld": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "ablated.logits",
      "a": "prompts.cf_answer",
      "b": "prompts.base_answer"
    },
    "saves": {"mean": "mean.safetensors", "clean_ld": "clean.json", "ablated_ld": "ablated.json"}
  }
}

{
  "header": {
    "description": "The interchange at a place inside a module's forward: the query the attention hands its implementation, after the projection, the head reshape and RoPE, at layer 0 \u2014 read on the counterfactual prompt at its last token and swapped into the base prompt's. nnterp's `attention_queries` row reaches it through nnsight's `.source`; the hooks engine refuses it by name. Only the logit difference is saved."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {
    "pairs": {
      "path": "weekdays/train"
    }
  },
  "sites": {
    "q": {
      "component": "attention_query",
      "layers": 0
    }
  },
  "steps": {
    "counterfactual": {
      "kind": "forward",
      "data": "pairs",
      "field": "counterfactual_inputs[0]",
      "reads": {
        "v_cf": {
          "site": "q",
          "pos": -1
        }
      }
    },
    "patched": {
      "kind": "forward",
      "data": "pairs",
      "field": "input",
      "interventions": {
        "writes": {
          "patch": {
            "site": "q",
            "pos": -1,
            "mechanism": "swap",
            "operand": "counterfactual.v_cf"
          }
        }
      },
      "reads": {
        "logits": {
          "site": {
            "component": "lm_head"
          },
          "pos": -1
        }
      }
    },
    "logit_diff": {
      "kind": "metric",
      "metric": "logit_diff",
      "of": "patched.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    },
    "saves": {
      "logit_diff": "logit_diff.json"
    }
  }
}

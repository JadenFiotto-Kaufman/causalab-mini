{
  "header": {
    "description": "The logit lens as one document: at every layer, push the residual stream at the answer position through the model's final norm and head and read what it would say if that were its last layer. `view: logits` is the projection; the layer sweep is the lens; `token_prob` on the answer is what to plot against depth. Two layers here, so two points."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"prompts": {"path": "weekdays/train"}},
  "sites": {"resid": {"component": "block_output", "layers": {"sweep": [[0], [1]]}}},
  "steps": {
    "lens": {
      "kind": "forward",
      "data": "prompts",
      "field": "input",
      "reads": {"logits": {"site": "resid", "pos": -1, "view": "logits"}}
    },
    "p_answer": {
      "kind": "metric",
      "metric": "token_prob",
      "of": "lens.logits",
      "token": "prompts.base_answer"
    },
    "top1": {
      "kind": "metric",
      "metric": "match",
      "of": "lens.logits",
      "expected": "prompts.base_answer"
    },
    "saves": {"p_answer": "p_answer.json", "top1": "top1.json"}
  }
}

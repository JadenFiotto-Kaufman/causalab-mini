{
  "header": {
    "description": "DAS on the tiny CPU Llama, written in causalab-mini's own plan-shaped format instead of the protocol's. The experiment is declared once under `intervention`; each step says which rows it runs over and what it writes out. Compare documents/das_cpu_reduction.json, which is the same run in the protocol's shape."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "roles": {
    "base": {
      "field": "input"
    },
    "counterfactual": {
      "field": "counterfactual_inputs[0]"
    }
  },
  "sites": {
    "target": {
      "component": "block_output",
      "layers": [
        0
      ]
    },
    "head": {
      "component": "lm_head"
    }
  },
  "featurizers": {
    "rot": {
      "kind": "subspace",
      "k": 8,
      "parametrization": "cayley"
    }
  },
  "intervention": {
    "reads": {
      "v_cf": {
        "site": "target",
        "pos": -1,
        "model": "original",
        "input": "counterfactual",
        "featurizer": "rot"
      },
      "logits": {
        "site": "head",
        "pos": -1,
        "model": "patched",
        "input": "base"
      }
    },
    "writes": {
      "patch": {
        "site": "target",
        "pos": -1,
        "do": {
          "swap": "v_cf"
        },
        "featurizer": "rot"
      }
    },
    "models": {
      "patched": {
        "input": "base",
        "writes": [
          "patch"
        ]
      }
    },
    "metrics": {
      "iia": {
        "kind": "logit_diff",
        "of": "logits",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      },
      "ce": {
        "kind": "cross_entropy",
        "of": "logits",
        "target": "cf_answer",
        "token_form": "space_prefixed"
      }
    }
  },
  "steps": {
    "fit": {
      "kind": "fit",
      "rows": {
        "base": "weekdays/data#train",
        "counterfactual": "weekdays/data#train"
      },
      "params": [
        "rot"
      ],
      "objective": [
        [
          1.0,
          "ce"
        ]
      ],
      "epochs": 10,
      "pairs": 16,
      "seed": 0,
      "optimizer": {
        "name": "adamw",
        "lr": 0.001,
        "weight_decay": 0.0
      },
      "early_stop": {
        "metric": "iia",
        "mode": "max",
        "patience": 3
      },
      "eval": {
        "rows": {
          "base": "weekdays/data#test",
          "counterfactual": "weekdays/data#test"
        },
        "saves": [
          {
            "value": "iia",
            "file_path": "held_out_iia.json"
          }
        ]
      }
    },
    "score": {
      "kind": "observe",
      "rows": {
        "base": "weekdays/data#train",
        "counterfactual": "weekdays/data#train"
      },
      "saves": [
        {
          "value": "iia",
          "file_path": "iia.json"
        },
        {
          "value": "ce",
          "file_path": "ce.json"
        }
      ]
    },
    "weights": {
      "kind": "weights",
      "names": [
        "rot"
      ],
      "saves": [
        {
          "value": "rot",
          "file_path": "rot.safetensors"
        }
      ]
    }
  }
}

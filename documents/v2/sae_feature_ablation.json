{
  "header": {
    "description": "SAE feature ablation. The residual stream at layer 0 is read through a loaded sparse autoencoder \u2014 an encoder/decoder pair with an ERROR TERM, so what the dictionary does not explain is put back exactly \u2014 and one latent at a time is set to zero (`features: [j]`, swept). An ablated latent that was already zero on these prompts changes nothing, which is the point of doing this in feature space: the sweep's own points are the comparison. The bundle here is a random 16->32 dictionary, a fixture: the mechanics are real, the latents mean nothing."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "roles": {
    "base": {
      "field": "input"
    }
  },
  "sites": {
    "target": {
      "component": "block_output",
      "layers": [
        0
      ]
    },
    "head": {
      "component": "lm_head"
    }
  },
  "featurizers": {
    "dictionary": {
      "kind": "sae",
      "file_path": "documents/artifacts/sae.safetensors"
    }
  },
  "interventions": {
    "ablate": {
      "reads": {
        "logits": {
          "site": "head",
          "pos": -1,
          "model": "zeroed",
          "input": "base"
        },
        "latents": {
          "site": "target",
          "pos": -1,
          "model": "original",
          "input": "base",
          "featurizer": "dictionary"
        }
      },
      "writes": {
        "ablate": {
          "site": "target",
          "pos": -1,
          "mechanism": "swap",
          "operand": 0.0,
          "featurizer": "dictionary",
          "features": {
            "sweep": [
              [
                0
              ],
              [
                1
              ],
              [
                2
              ],
              [
                3
              ]
            ]
          }
        }
      },
      "models": {
        "zeroed": {
          "input": "base",
          "writes": [
            "ablate"
          ]
        }
      },
      "metrics": {
        "logit_diff": {
          "kind": "logit_diff",
          "of": "logits",
          "a": "cf_answer",
          "b": "base_answer"
        },
        "p_answer": {
          "kind": "token_prob",
          "of": "logits",
          "token": "cf_answer"
        }
      }
    }
  },
  "steps": {
    "ablate": {
      "kind": "observe",
      "intervention": "ablate",
      "rows": {
        "base": "weekdays/train"
      },
      "saves": [
        {
          "value": "logit_diff",
          "file_path": "zeroed.json"
        },
        {
          "value": "p_answer",
          "file_path": "p_answer.json"
        }
      ],
      "outputs": {
        "active": {
          "read": "latents"
        }
      }
    }
  }
}

{
  "header": {
    "description": "Attention knockout, and the pattern it knocks out. Under eager attention the softmax's return is a tensor: `attention_probs`, (batch, head, query, key). This reads the last query position's pattern for every head, publishes it, and in the patched model zeroes ONE head's pattern at that position \u2014 the head then contributes nothing there \u2014 swept over heads. `attn_implementation: eager` is in the model block because sdpa never materializes the pattern."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32",
    "attn_implementation": "eager"
  },
  "roles": {
    "base": {
      "field": "input"
    },
    "counterfactual": {
      "field": "counterfactual_inputs[0]"
    }
  },
  "sites": {
    "pattern": {
      "component": "attention_probs",
      "layers": [
        0
      ]
    },
    "one_head": {
      "component": "attention_probs",
      "layers": [
        0
      ],
      "heads": {
        "sweep": [
          [
            0
          ],
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      }
    },
    "head": {
      "component": "lm_head"
    }
  },
  "interventions": {
    "knockout": {
      "reads": {
        "pattern": {
          "site": "pattern",
          "pos": -1,
          "model": "original",
          "input": "base"
        },
        "logits": {
          "site": "head",
          "pos": -1,
          "model": "patched",
          "input": "base"
        }
      },
      "writes": {
        "zero": {
          "site": "one_head",
          "pos": -1,
          "mechanism": "swap",
          "operand": 0.0
        }
      },
      "models": {
        "patched": {
          "input": "base",
          "writes": [
            "zero"
          ]
        }
      },
      "metrics": {
        "iia": {
          "kind": "match",
          "of": "logits",
          "expected": "cf_answer",
          "token_form": "space_prefixed"
        },
        "logit_diff": {
          "kind": "logit_diff",
          "of": "logits",
          "a": "cf_answer",
          "b": "base_answer",
          "token_form": "space_prefixed"
        }
      }
    }
  },
  "steps": {
    "score": {
      "kind": "observe",
      "rows": {
        "base": "weekdays/train",
        "counterfactual": "weekdays/train"
      },
      "saves": [
        {
          "value": "iia",
          "file_path": "iia.json"
        },
        {
          "value": "logit_diff",
          "file_path": "logit_diff.json"
        },
        {
          "value": "last_pattern",
          "file_path": "pattern.safetensors"
        }
      ],
      "outputs": {
        "last_pattern": {
          "read": "pattern"
        }
      }
    }
  }
}

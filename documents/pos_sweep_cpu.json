{
  "header": {
    "protocol_version": "3",
    "description": "AUTHORED FOR causalab-mini, not shipped with causalab. minimal_cpu.json with the patched position swept: the same interchange at the last token, the one before it, and the one before that. One document, three experiments, one model load \u2014 which is what the protocol's sweep wrappers are for. Used to test that a plan tree needs nothing beyond a root plan with three children to say so."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {
    "base": {
      "dataset": "weekdays/train",
      "field": "input"
    },
    "counterfactual": {
      "dataset": "weekdays/train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "sites": {
      "target": {
        "component": "block_output",
        "layers": [
          0
        ]
      },
      "lm_head": {
        "component": "lm_head"
      }
    },
    "reads": {
      "v_cf": {
        "site": "target",
        "pos": -1,
        "model": "original",
        "input": "counterfactual"
      },
      "logits": {
        "site": "lm_head",
        "pos": -1,
        "model": "patched",
        "input": "base"
      }
    },
    "writes": {
      "patch": {
        "site": "target",
        "pos": {
          "sweep": [
            -1,
            -2,
            -3
          ]
        },
        "do": {
          "swap": "v_cf"
        }
      }
    },
    "intervened_models": {
      "patched": {
        "input": "base",
        "writes": [
          "patch"
        ]
      }
    },
    "metrics": {
      "iia": {
        "kind": "match",
        "of": "logits",
        "expected": "cf_answer",
        "token_form": "space_prefixed"
      },
      "logit_diff": {
        "kind": "logit_diff",
        "of": "logits",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      }
    },
    "save": [
      {
        "value": "iia",
        "model": "patched",
        "input": "base",
        "file_path": "iia.json"
      },
      {
        "value": "logit_diff",
        "model": "patched",
        "input": "base",
        "file_path": "logit_diff.json"
      }
    ]
  }
}

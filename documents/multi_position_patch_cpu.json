{
  "header": {
    "protocol_version": "3",
    "description": "AUTHORED FOR causalab-mini from causalab's configs/protocols/multi_position_patch.json, retargeted to the tiny CPU Llama. Three swaps on ONE site at non-overlapping positions inside one intervened model. Protocol rule 8 is what makes it expressible: at most one absolute write per (site, OVERLAPPING pos, model), so three disjoint indices are three legal absolute writes rather than a conflict. An effect carried jointly by several positions can read 0.000 at every layer when each position is patched alone."
  },
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {
    "base": {
      "dataset": "weekdays/train",
      "field": "input"
    },
    "counterfactual": {
      "dataset": "weekdays/train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "sites": {
      "target": {
        "component": "block_output",
        "layers": [
          0
        ]
      },
      "lm_head": {
        "component": "lm_head"
      }
    },
    "reads": {
      "v_m4": {
        "site": "target",
        "pos": -4,
        "model": "original",
        "input": "counterfactual"
      },
      "v_m3": {
        "site": "target",
        "pos": -3,
        "model": "original",
        "input": "counterfactual"
      },
      "v_m2": {
        "site": "target",
        "pos": -2,
        "model": "original",
        "input": "counterfactual"
      },
      "logits": {
        "site": "lm_head",
        "pos": -1,
        "model": "patched",
        "input": "base"
      }
    },
    "writes": {
      "at_m4": {
        "site": "target",
        "pos": -4,
        "do": {
          "swap": "v_m4"
        }
      },
      "at_m3": {
        "site": "target",
        "pos": -3,
        "do": {
          "swap": "v_m3"
        }
      },
      "at_m2": {
        "site": "target",
        "pos": -2,
        "do": {
          "swap": "v_m2"
        }
      }
    },
    "intervened_models": {
      "patched": {
        "input": "base",
        "writes": [
          "at_m4",
          "at_m3",
          "at_m2"
        ]
      }
    },
    "metrics": {
      "iia": {
        "kind": "match",
        "of": "logits",
        "expected": "cf_answer",
        "token_form": "space_prefixed"
      },
      "logit_diff": {
        "kind": "logit_diff",
        "of": "logits",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      }
    },
    "save": [
      {
        "value": "iia",
        "model": "patched",
        "input": "base",
        "file_path": "iia.json"
      },
      {
        "value": "logit_diff",
        "model": "patched",
        "input": "base",
        "file_path": "logit_diff.json"
      }
    ]
  }
}

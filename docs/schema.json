  },
  "Weights": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "weights",
     "title": "Kind",
     "type": "string"
    },
    "names": {
     "items": {
      "type": "string"
     },
     "title": "Names",
     "type": "array"
    },
    "saves": {
     "items": {
      "$ref": "#/$defs/Save"
     },
     "title": "Saves",

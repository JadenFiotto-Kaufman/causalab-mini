  },
  "Where": {
   "additionalProperties": false,
   "description": "Where along the sequence, per row \u2014 a spec, never an integer.\n\nThree independent questions, one field each:\n\n    frame                 which sequence: the prompt, or what was generated\n    scope                 which run of it: the row's content, or an anchor's\n    index/span/last/all   how much of that run\n\nExactly one of index/span/last/all; negatives count from the end of the\nrun. Resolution happens where the model is, per row, against its\ntokenizer, so `{\"index\": -1, \"scope\": {\"variable\": \"entity\"}}` is the\nlast token of *this row's* entity \u2014 whatever text that is, and however\nmany tokens it takes. That is the whole point: the spec is the same for\nevery row and the integer is not.",
   "properties": {
    "index": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Index"
    },
    "span": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "integer"
        },
        {
         "type": "integer"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Span"
    },
    "last": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Last"
    },
    "all": {
     "default": false,
     "title": "All",
     "type": "boolean"
    },
    "scope": {
     "anyOf": [
      {
       "$ref": "#/$defs/Anchor"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "frame": {
     "default": "prompt",
     "enum": [
      "prompt",
      "generated"
     ],
     "title": "Frame",
     "type": "string"
    }
   },
   "title": "Where",
   "type": "object"
  },
  "Write": {
   "additionalProperties": false,
   "description": "`mechanism` and `operand` are two fields, not the protocol's\n`{\"swap\": \"v_cf\"}`, because a key that is itself the mechanism's name\ncannot be enumerated by a schema \u2014 and the schema is what an agent\nreads. The operand is a read of this intervention, or a reference to\nwhat an earlier step output.",
   "properties": {
    "site": {
     "title": "Site",
     "type": "string"
    },
    "pos": {
     "$ref": "#/$defs/Where"
    },
    "mechanism": {
     "enum": [
      "swap",
      "add_scaled",
      "lerp",
      "gaussian",
      "clamp",
      "renormalize"
     ],
     "title": "Mechanism",
     "type": "string"
    },
    "operand": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "$ref": "#/$defs/Reference"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Operand"
    },
    "featurizer": {
     "default": "identity",
     "title": "Featurizer",
     "type": "string"
    },
    "features": {
     "anyOf": [
      {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Features"
